#!/bin/bash
# Launch the Operator dashboard as a chromeless Chrome "app window":
# no tabs, no address bar, no bookmarks bar.

DIR="$(cd "$(dirname "$0")/.." && pwd)"
HTML_FILE="$DIR/Resources/command-center-2.html"

CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

if [ ! -x "$CHROME" ]; then
  osascript -e 'display alert "Google Chrome not found" message "Operator needs Google Chrome installed at /Applications/Google Chrome.app to run as an app window." as critical'
  exit 1
fi

# A dedicated Chrome profile just for this app, so it doesn't interfere
# with your normal Chrome windows/tabs/history.
PROFILE_DIR="$HOME/Library/Application Support/OperatorAppProfile"
mkdir -p "$PROFILE_DIR"

# --- App Activity tracking -------------------------------------------------
# Operator can show which app is currently in the foreground and auto lock-in
# when you've been steady on one app for a while. A web page can't see other
# apps on its own, so this wrapper does the OS-level part: it polls the
# frontmost app (and, in a browser, the website's domain) via System Events and serves
# recent samples over a tiny,
# loopback-only (127.0.0.1) HTTP endpoint that the page polls. Nothing here
# ever leaves the machine, and if any of this fails, the app just runs
# without that feature — everything else works normally either way.
DATA_DIR="$HOME/Library/Application Support/Operator"
mkdir -p "$DATA_DIR"
ACTIVITY_LOG="$DATA_DIR/activity.log"
touch "$ACTIVITY_LOG" 2>/dev/null
ACTIVITY_PORT=8934

poll_frontmost() {
  while true; do
    APP=$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)
    # Seconds since the last keyboard/mouse input, so the page only counts active use
    # (an app merely left open in the foreground doesn't count toward auto lock-in).
    IDLE=$(ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ {print int($NF/1000000000); exit}')
    # In a browser, also note which website is open (just the domain), so sites can be
    # sorted into work / not work like apps. macOS asks once for permission to read it.
    SITE=""
    case "$APP" in
      "Google Chrome"|"Brave Browser"|"Microsoft Edge"|"Arc"|"Chromium")
        URL=$(osascript -e "tell application \"$APP\" to get URL of active tab of front window" 2>/dev/null) ;;
      "Safari")
        URL=$(osascript -e 'tell application "Safari" to get URL of front document' 2>/dev/null) ;;
      *) URL="" ;;
    esac
    if [ -n "$URL" ]; then
      case "$URL" in
        file://*Operator*|file://*command-center*) SITE="Operator" ;;
        http://*|https://*) SITE=$(printf '%s' "$URL" | sed -E 's#^[a-z]+://##; s#/.*$##; s#:.*$##; s#^www\.##') ;;
      esac
    fi
    if [ -n "$APP" ]; then
      printf '%s\t%s\t%s\t%s\n' "$(date +%s000)" "$APP" "${IDLE:-0}" "$SITE" >> "$ACTIVITY_LOG" 2>/dev/null
    fi
    # Keep the log from growing forever — the app only ever needs recent history.
    if [ -f "$ACTIVITY_LOG" ]; then
      tail -n 6000 "$ACTIVITY_LOG" > "$ACTIVITY_LOG.tmp" 2>/dev/null && mv "$ACTIVITY_LOG.tmp" "$ACTIVITY_LOG" 2>/dev/null
    fi
    sleep 10
  done
}

serve_activity() {
  while true; do
    { printf 'HTTP/1.1 200 OK\r\nAccess-Control-Allow-Origin: *\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\n'
      cat "$ACTIVITY_LOG" 2>/dev/null
    } | nc -l 127.0.0.1 "$ACTIVITY_PORT" >/dev/null 2>&1
  done
}

# --- Alarm wake-up helper ---------------------------------------------------
# The page talks to 127.0.0.1:8935 when an alarm rings:
#   /wake        bring the Operator window to the front, wake the display, unmute
#   /music/play  play a song or playlist from Apple Music (?k=song|playlist&q=<name, hex>)
#   /music/stop  pause it again ("I'm up" / snooze)
# Wake-up music through the Music app has no ads and doesn't depend on the browser.
# If the song can't be found (or Music isn't allowed), the Mac's own alert sound rings
# instead, so you still wake up.
WAKE_PORT=8935
RAMP_PID_FILE="$DATA_DIR/music-ramp.pid"
FALLBACK_PID_FILE="$DATA_DIR/music-fallback.pid"
wake_front() {
  caffeinate -u -t 5 >/dev/null 2>&1 &
  # An alarm nobody can hear is no alarm: unmute, and bring a very low volume up.
  osascript -e 'set v to output volume of (get volume settings)' -e 'if v < 35 then set volume output volume 50' -e 'set volume without output muted' >/dev/null 2>&1
  osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $CHROME_PID) to true" >/dev/null 2>&1
}
stop_music() {
  for f in "$RAMP_PID_FILE" "$FALLBACK_PID_FILE"; do
    if [ -f "$f" ]; then kill "$(cat "$f")" 2>/dev/null; rm -f "$f"; fi
  done
  osascript >/dev/null 2>&1 <<'APPLESCRIPT'
if application "Music" is running then
  tell application "Music"
    if player state is playing then pause
    set song repeat to off
  end tell
end if
APPLESCRIPT
}
play_music() {
  stop_music
  RESULT=$(osascript - "$1" "$2" 2>/dev/null <<'APPLESCRIPT'
on run argv
  set q to item 1 of argv
  set k to item 2 of argv
  tell application "Music"
    set sound volume to 35
    if k is "playlist" then
      try
        set song repeat to all
        play playlist q
        return "ok"
      end try
    end if
    try
      set hits to (search library playlist 1 for q only songs)
      if (count of hits) > 0 then
        set song repeat to one
        play (item 1 of hits)
        return "ok"
      end if
    end try
    try
      set song repeat to all
      play playlist q
      return "ok"
    end try
  end tell
  return "notfound"
end run
APPLESCRIPT
)
  if [ "$RESULT" = "ok" ]; then
    # fade the music up over about a minute
    ( for v in 45 55 65 75 85 100; do
        sleep 8
        osascript -e "tell application \"Music\" to set sound volume to $v" >/dev/null 2>&1
      done ) &
    echo $! > "$RAMP_PID_FILE"
  else
    ( n=0; while [ $n -lt 300 ]; do afplay /System/Library/Sounds/Glass.aiff >/dev/null 2>&1; n=$((n+1)); done ) &
    echo $! > "$FALLBACK_PID_FILE"
  fi
}
serve_wake() {
  while true; do
    REQ=$(printf 'HTTP/1.1 200 OK\r\nAccess-Control-Allow-Origin: *\r\nContent-Type: text/plain\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok' \
      | nc -l 127.0.0.1 "$WAKE_PORT" 2>/dev/null | sed -n '1p')
    REQ_PATH=$(printf '%s' "$REQ" | awk '{print $2}')
    case "$REQ_PATH" in
      /music/play*)
        K=$(printf '%s' "$REQ_PATH" | sed -n 's/.*[?&]k=\([a-z]*\).*/\1/p')
        HEX=$(printf '%s' "$REQ_PATH" | sed -n 's/.*[?&]q=\([0-9a-fA-F]*\).*/\1/p')
        Q=$(printf '%b' "$(printf '%s' "$HEX" | sed 's/../\\x&/g')")
        if [ -n "$Q" ]; then play_music "$Q" "${K:-song}" & fi
        ;;
      /music/stop*)
        stop_music &
        ;;
      *)
        wake_front &
        ;;
    esac
  done
}

POLL_PID=""
SERVE_PID=""
if command -v osascript >/dev/null 2>&1 && command -v nc >/dev/null 2>&1; then
  poll_frontmost &
  POLL_PID=$!
  serve_activity &
  SERVE_PID=$!
fi

# Chrome flags for an app that has to ring on time:
#  - background windows normally get their timers slowed to ~1/minute, which made
#    alarms only go off once the window was opened; these flags keep them on time
#  - autoplay without a click, so wake-up music/sound starts by itself
#  - no pop-up blocking, so a wake-up YouTube link / second-screen view can open
"$CHROME" \
  --app="file://$HTML_FILE" \
  --user-data-dir="$PROFILE_DIR" \
  --window-size=1400,900 \
  --no-first-run \
  --no-default-browser-check \
  --autoplay-policy=no-user-gesture-required \
  --disable-background-timer-throttling \
  --disable-renderer-backgrounding \
  --disable-backgrounding-occluded-windows \
  --disable-popup-blocking \
  > /dev/null 2>&1 &
CHROME_PID=$!

WAKE_PID=""
CAFF_PID=""
if command -v osascript >/dev/null 2>&1 && command -v nc >/dev/null 2>&1; then
  serve_wake &
  WAKE_PID=$!
fi
# Keep the Mac from idle-sleeping while Operator is open (the display can still turn
# off), so a morning alarm can fire. Closing the lid on battery still sleeps.
if command -v caffeinate >/dev/null 2>&1; then
  caffeinate -i -w "$CHROME_PID" >/dev/null 2>&1 &
  CAFF_PID=$!
fi

cleanup() {
  stop_music >/dev/null 2>&1
  [ -n "$POLL_PID" ] && kill "$POLL_PID" 2>/dev/null
  [ -n "$SERVE_PID" ] && kill "$SERVE_PID" 2>/dev/null
  [ -n "$WAKE_PID" ] && kill "$WAKE_PID" 2>/dev/null
  [ -n "$CAFF_PID" ] && kill "$CAFF_PID" 2>/dev/null
}
trap cleanup EXIT

# Wait for Chrome to actually quit before this wrapper exits, so the
# background poller/server above get cleaned up instead of lingering.
wait "$CHROME_PID"
